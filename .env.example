# Discord Bot Token (Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=your_bot_token_here

# Discord Client ID (Discord Developer Portal -> General Information -> Application ID)
CLIENT_ID=your_client_id_here

# Bot faqat ishlaydigan yagona asosiy Server ID si (Masalan: 123456789012345678)
# Agar kiritilsa, bot faqat shu serverda ishlaydi, boshqa serverlarga kiritilsa o'zi chiqib ketadi
ALLOWED_GUILD_ID=

# Asosiy bot egasi / adminining shaxsiy Discord ID si (Masalan: 987654321098765432)
OWNER_ID=

# Render yoki server porti (Render avtomatik beradi, lokalda 3000)
PORT=3000

# Buyruqlarni avtomatik ro'yxatdan o'tkazish (true/false)
AUTO_DEPLOY=true
